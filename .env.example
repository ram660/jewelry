# Copy this file to .env.local and fill in your keys, then restart `npm run dev`.
# Keys are optional. Anything without a key runs in DEMO MODE (placeholders).

# ---- Two jobs, chosen separately -------------------------------------------------------------
# VISION_PROVIDER: who reads photos and makes decisions (details, captions, match scores)
#   claude | gemini | deepinfra | openrouter | demo | auto
# IMAGE_PROVIDER: who makes pictures (Claude cannot)
#   gemini | fal | none | auto
#   none = no AI makes any picture: scenes are your real cutout (BiRefNet) on a backdrop drawn by code; on-model and scale shots are off.
#   auto = fal.ai if its key is set, otherwise none. A Gemini key alone never switches picture-making on; choose gemini on purpose.
VISION_PROVIDER=auto
IMAGE_PROVIDER=auto
# Older all-in-one switch, used when the two above are "auto": gemini | open | demo | auto
AI_PROVIDER=auto

# ---- Claude (https://console.anthropic.com -> API keys; billed per use, separate from a claude.ai plan)
ANTHROPIC_API_KEY=
# claude-opus-5-5 ($4 in / $20 out per 1M tokens) is the default. Cheaper options:
#   claude-sonnet-5-5 ($2 / $10)      claude-haiku-5-5 ($0.10 / $0.50)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high: how hard Claude thinks. medium is a good default.
CLAUDE_EFFORT=medium

# ---- Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ---- fal.ai (https://fal.ai/dashboard/keys): open-weight pictures + safe-mode cutouts
FAL_KEY=
FAL_EDIT_MODEL=fal-ai/qwen-image-edit-plus
FAL_CUTOUT_MODEL=fal-ai/birefnet/v2
FAL_BACKDROP_MODEL=fal-ai/flux/schnell

# ---- OpenRouter (https://openrouter.ai/settings/keys): free photo-reading models behind one key. Set VISION_PROVIDER=openrouter to use it.
# Free models allow 20 requests a minute and 50 a day until you buy credits. They may keep your prompts, and only product photos are
# sent. Models are tried in order (at most 3). The defaults were measured on this app's own tasks (docs/REFERENCES.md).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# strict = only providers that promise not to keep or train on prompts (few free models qualify, so requests may fail)
OPENROUTER_PRIVACY=

# ---- Cutouts ("Remove background" and safe-mode scenes)
# auto  = free gold-colour method first; fal.ai BiRefNet when fal is the image provider or colour fails;
#         BiRefNet on this computer when there is no fal key (after: node scripts/get-birefnet.mjs lite)
# local = BiRefNet on this computer for everything (free, private, but slow on a laptop CPU)
# fal   = fal.ai BiRefNet for everything     gold = gold-colour method only
CUTOUT_MODE=auto
# Which downloaded model to use: lite (default, 214 MB) | lite-fp16 (109 MB) | full (467 MB) | a full file path
BIREFNET_MODEL=
# Where the model files are kept (default: ~/.efj-studio/models, outside the project and outside OneDrive)
EFJ_MODEL_DIR=

# ---- DeepInfra (https://deepinfra.com/dash/api_keys): open-weight photo reading
DEEPINFRA_API_KEY=
DEEPINFRA_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# ---- Instagram inbox (docs/INSTAGRAM.md). All optional: the inbox also works with messages pasted in by hand.
# Address of your small public relay, and the secret this Studio uses to collect messages from it (24+ random characters).
RELAY_URL=
RELAY_PULL_TOKEN=
# Needed only to SEND replies from the Studio. Keep it here, never on the relay.
IG_ACCESS_TOKEN=
# off = approve here, then send by hand in the Instagram app (default). live = send through the API when you press the button.
IG_SEND_MODE=off

# ---- Free stock photos and videos for education and mood posts (npm run stock). Each key is free; a site without one is skipped.
# https://www.pexels.com/api/   https://pixabay.com/api/docs/   https://unsplash.com/developers (demo keys: 50 requests an hour)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Generated images scoring below this match percentage are flagged in red.
FIDELITY_MIN=75

# Recommended for this shop: Gemini reasons, pictures stay real (no AI pixels)
#   VISION_PROVIDER=gemini
#   IMAGE_PROVIDER=none
# CUTOUT_MODE: auto (BiRefNet or gold-colour, chosen per photo) | local (BiRefNet only) | gold | fal
#   Run `node scripts/get-birefnet.mjs` once to download the local model.
CUTOUT_MODE=auto
# The Studio only answers on localhost. Add extra host names here (comma-separated) if you really need to.
# EFJ_ALLOWED_HOSTS=
